# Copy this file to .env and fill in your values. Never commit .env.

# ---- Qdrant Cloud --------------------------------------------------------
# Cluster URL from cloud.qdrant.io -> your cluster -> "Endpoint" (include :6333)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=sentinel_corpus

# ---- Embeddings ----------------------------------------------------------
# google = Google Gemini API directly, euri = Euron EURI gateway, fake = offline test vectors
EMBED_PROVIDER=google
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=3072

# Google AI Studio key (https://aistudio.google.com/apikey), used when EMBED_PROVIDER=google
GEMINI_API_KEY=your-gemini-api-key

# Euron EURI gateway, used when EMBED_PROVIDER=euri.
# Check the base URL and the exact embedding model name in your EURI dashboard,
# then set EMBED_MODEL above to that name.
EURI_API_KEY=your-euri-api-key
EURI_BASE_URL=https://api.euron.one/api/v1/euri

# Batching / rate limits (lower the batch size or raise the pause on free tiers)
EMBED_BATCH_SIZE=16
EMBED_PAUSE_SECONDS=0.5

# ---- Chunking ------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
